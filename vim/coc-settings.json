{
    "suggest.noselect": true,
    "inlayHint.enable": false,

    "rust-analyzer.diagnostics.disabled": [ "inactive-code" ],

    "diagnostic-languageserver.filetypes": {
        "sh": "shellcheck"
    },

    "languageserver": {
        "wasm-language-tools": {
            "command": "wat_server",
            "filetypes": ["wat"]
        }
    }
}
